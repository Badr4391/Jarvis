# ─── Jarvis Konfiguration (Kopie als .env anlegen) ──────────────────────────
# Nichts davon ist Pflicht. Jarvis läuft auch komplett ohne Keys (Offline-Modus).

# LLM: Anthropic (empfohlen) ------------------------------------------------
ANTHROPIC_API_KEY=
JARVIS_LLM_PROVIDER=anthropic          # anthropic | ollama | echo
JARVIS_LLM_MODEL=claude-opus-5

# LLM: lokal via Ollama (local-first, kein Cloud-Call) ----------------------
OLLAMA_HOST=http://localhost:11434
# JARVIS_LLM_PROVIDER=ollama
# JARVIS_LLM_MODEL=qwen2.5:14b-instruct

# Marktdaten: Financial Modeling Prep --------------------------------------
FMP_API_KEY=

# Kontostände: FundedNext ---------------------------------------------------
# Token aus dem eingeloggten Dashboard: DevTools → Network → beliebiger
# API-Aufruf → Header "Authorization: Bearer ...". Läuft regelmäßig ab.
FUNDEDNEXT_TOKEN=
# FUNDEDNEXT_API_URL=https://api.fundednext.com/api/v1

# Push aufs Handy -----------------------------------------------------------
# ntfy: App installieren, langen zufälligen Themennamen wählen, hier eintragen.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# Telegram: Bot bei @BotFather anlegen, dem Bot schreiben,
# dann `jarvis notify --chat-id` aufrufen.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App im Heimnetz (Pflicht, sobald nicht nur 127.0.0.1) ---------------------
# JARVIS_WEB_TOKEN=langes-zufaelliges-geheimnis

# Sprache / Stimme ----------------------------------------------------------
JARVIS_TTS=auto                        # auto | piper | espeak | say | none
JARVIS_STT=auto                        # auto | whisper-cpp | faster-whisper | none
PIPER_MODEL=                           # z.B. /opt/piper/de_DE-thorsten-medium.onnx
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# Sonstiges -----------------------------------------------------------------
JARVIS_DATA_DIR=./data
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANG=de
